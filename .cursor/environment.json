{
  "name": "FS PBX",
  "user": "ubuntu",
  "install": "bash /agent/repos/fspbx/.cursor/install.sh",
  "start": "bash /agent/repos/fspbx/.cursor/start.sh",
  "terminals": [
    {
      "name": "app-server",
      "command": "cd /agent/repos/fspbx && php artisan serve --host=0.0.0.0 --port=8000"
    },
    {
      "name": "queue-worker",
      "command": "cd /agent/repos/fspbx && php artisan queue:work --tries=1 --timeout=90"
    }
  ],
  "ports": [8000]
}
